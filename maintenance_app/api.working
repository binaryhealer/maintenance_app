import frappe
import json


@frappe.whitelist()
def create_tech_planning_from_ticket(ticket, assignees=None):
    hd = frappe.get_doc("HD Ticket", ticket)

    valid_users = []

    if assignees:
        try:
            assigned_list = json.loads(assignees) if isinstance(assignees, str) else assignees

            for user in assigned_list:
                if isinstance(user, dict):
                    user_id = user.get("email") or user.get("name") or user.get("user")
                else:
                    user_id = user

                if user_id and user_id not in valid_users:
                    valid_users.append(user_id)

        except Exception:
            pass

    assignments = frappe.get_all(
        "ToDo",
        filters={
            "reference_type": "HD Ticket",
            "reference_name": hd.name,
            "status": "Open"
        },
        fields=["name", "allocated_to"]
    )

    for a in assignments:
        allocated_to = a.get("allocated_to")
        if allocated_to and allocated_to not in valid_users:
            valid_users.append(allocated_to)

    if not valid_users and hd.get("_assign"):
        try:
            assigned_users = json.loads(hd.get("_assign") or "[]")

            for user in assigned_users:
                if user and user not in valid_users:
                    valid_users.append(user)

        except Exception:
            pass

    if not valid_users:
        return {
            "error": "missing_technician",
            "message": "Please select at least 1 technician before creating Tech Planning."
        }

    asset_customer = None
    asset_branch = None

    if hd.get("custom_target_asset"):
        asset_vals = frappe.db.get_value(
            "Maintenance App Asset Registry",
            hd.get("custom_target_asset"),
            ["custom_parent_customer", "custom_branch"],
            as_dict=True
        )

        if asset_vals:
            asset_customer = asset_vals.get("custom_parent_customer")
            asset_branch = asset_vals.get("custom_branch")

    full_description = "Ticket: " + str(hd.name)

    if hd.get("subject"):
        full_description += "\n\nSubject: " + str(hd.get("subject"))

    if hd.get("description"):
        full_description += "\n\n" + str(hd.get("description"))

    planning = frappe.new_doc("Tech Planning")
    planning.custom_hd_ticket = hd.name
    planning.custom_parent_customer = hd.get("custom_customer") or hd.get("customer") or asset_customer
    planning.custom_branch = hd.get("custom_client_branch") or asset_branch
    planning.custom_asset = hd.get("custom_target_asset")
    planning.custom_service_type = hd.get("custom_service_type")
    planning.custom_request_description = full_description
    planning.custom_analytic_number = hd.get("custom_analytic_number") or ""

    for user in valid_users:
        planning.append("custom_planned_team", {
            "custom_technician": user
        })

    planning.insert(ignore_permissions=True)

    frappe.db.set_value(
        "HD Ticket",
        hd.name,
        "custom_planning_ref",
        planning.name
    )

    return {
        "name": planning.name
    }


@frappe.whitelist()
def create_invoice_from_ticket(ticket):
    hd = frappe.get_doc("HD Ticket", ticket)

    customer = hd.get("custom_customer") or hd.get("customer")

    if not customer:
        frappe.throw("Customer is required on HD Ticket before creating invoice.")

    invoice = frappe.new_doc("Sales Invoice")
    invoice.customer = customer
    invoice.custom_hd_ticket = hd.name

    passed_commercial_process = False

    if (hd.get("custom_total_quoted_amount") or 0) > 0:
        passed_commercial_process = True

    service_item = hd.get("custom_service_billing_item") or "TECH-LABOUR"

    latest_work_progress = ""
    has_stock_items = False
    added_items = 0

    interventions = frappe.get_all(
        "Mission Intervention",
        filters={
            "custom_parent_ticket": hd.name,
            "docstatus": ["!=", 2]
        },
        fields=["name", "custom_end_time"],
        order_by="custom_end_time desc"
    )

    for mi in interventions:
        mi_doc = frappe.get_doc("Mission Intervention", mi.name)

        if not latest_work_progress and mi_doc.get("custom_work_progress"):
            latest_work_progress = mi_doc.get("custom_work_progress")

        for part in mi_doc.get("custom_parts_table") or []:
            if (
                part.get("custom_item_code")
                and part.get("custom_qty")
                and part.get("custom_is_billed")
            ):

                if not part.get("custom_warehouse"):
                    frappe.throw(
                        "Warehouse is required for item {0} in Mission Intervention {1}".format(
                            part.get("custom_item_code"),
                            mi_doc.name
                        )
                    )

                invoice.append("items", {
                    "item_code": part.get("custom_item_code"),
                    "qty": part.get("custom_qty"),
                    "warehouse": part.get("custom_warehouse"),
                    "description": "Ticket: {0}<br>Mission Intervention: {1}<br>Brand: {2}".format(
                        hd.name,
                        mi_doc.name,
                        part.get("custom_brand") or "-"
                    )
                })

                has_stock_items = True
                added_items += 1

    if service_item:
        invoice.append("items", {
            "item_code": service_item,
            "qty": 1,
            "rate": 0,
            "description": "Ticket: {0}<br><br>{1}".format(
                hd.name,
                latest_work_progress or "Service / labour charges"
            )
        })

        added_items += 1

    if added_items == 0:
        frappe.throw("No service item or billable parts found for this ticket.")

    if passed_commercial_process:
        invoice.update_stock = 0
    else:
        invoice.update_stock = 1 if has_stock_items else 0

    invoice.insert(ignore_permissions=True)

    return {
        "name": invoice.name
    }
