import frappe


@frappe.whitelist()
def create_tech_planning_from_ticket(ticket):
    hd = frappe.get_doc("HD Ticket", ticket)

    asset_customer = ""
    asset_branch = ""

    if hd.custom_target_asset:
        asset_vals = frappe.db.get_value(
            "Maintenance App Asset Registry",
            hd.custom_target_asset,
            ["custom_parent_customer", "custom_branch"],
            as_dict=True
        )

        if asset_vals:
            asset_customer = asset_vals.custom_parent_customer
            asset_branch = asset_vals.custom_branch

    full_description = ""

    if hd.subject:
        full_description = hd.subject

    if hd.description:
        full_description = full_description + "\n\n" + hd.description

    planning = frappe.new_doc("Tech Planning")

    planning.custom_hd_ticket = hd.name
    planning.custom_parent_customer = hd.custom_customer or hd.customer or asset_customer
    planning.custom_branch = hd.custom_client_branch or asset_branch
    planning.custom_asset = hd.custom_target_asset
    planning.custom_service_type = hd.custom_service_type
    planning.custom_request_description = full_description
    planning.custom_analytic_number = hd.custom_analytic_number or ""

    assignments = frappe.get_all(
        "ToDo",
        filters={
            "reference_type": "HD Ticket",
            "reference_name": hd.name,
            "status": "Open"
        },
        fields=["name", "allocated_to"]
    )

    for a in assignments:
        if a.allocated_to:
            planning.append("custom_planned_team", {
                "custom_technician": a.allocated_to
            })

    planning.insert(ignore_permissions=True)

    for a in assignments:
        try:
            todo = frappe.get_doc("ToDo", a.name)

            todo.description = (
                "Maintenance Assignment\n\n"
                + "Ticket: " + str(hd.name) + "\n"
                + "Tech Planning: " + str(planning.name) + "\n"
                + "Customer: " + str(planning.custom_parent_customer or "-") + "\n"
                + "Branch: " + str(planning.custom_branch or "-") + "\n"
                + "Asset: " + str(planning.custom_asset or "-") + "\n"
                + "Type: " + str(hd.custom_intervention_type or "-") + "\n\n"
                + "Tech Planning has been created."
            )

            todo.save(ignore_permissions=True)

        except Exception as e:
            frappe.log_error(str(e), "ToDo Description Update Failed")

    frappe.db.set_value(
        "HD Ticket",
        hd.name,
        "custom_planning_ref",
        planning.name
    )

    return {
        "name": planning.name
    }
